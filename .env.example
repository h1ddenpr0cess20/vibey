# Copy to .env — both `npm run dev` and `npm start` read it.
# The key stays in the Node process. The browser talks to our own /realtime
# socket, never to api.x.ai, so no credential of any kind reaches the page.
XAI_API_KEY=xai-...

# Which voice Star opens on — all 26 xAI publishes, or a custom voice
# id, which is honoured and added to the picker:
# leo, rex, sal, atlas, zagan, orion, perseus, helix, zenith, rigel,
# castor, ursa, naksh, kepler, ara, eve, carina, luna, iris, celeste,
# lumen, lux, cosmo, sirius, altair, helios
# XAI_VOICE=sirius

# grok-voice-latest tracks the newest release; pin a snapshot if you'd rather.
# XAI_MODEL=grok-voice-latest

# Point the proxy at a gateway or a stub instead of xAI.
# XAI_REALTIME_URL=wss://api.x.ai/v1/realtime

# Server-side tools. All three are executed by xAI, not by us — no keys needed,
# no sandbox to run. The code interpreter is Python in xAI's own sandbox, which
# is how it checks an answer instead of reasoning about it out loud.
# XAI_WEB_SEARCH=true
# XAI_X_SEARCH=true
# XAI_CODE_INTERPRETER=true

# Memory: the remember/forget tools, and the memory block in the prompt. The
# list itself lives in the browser — set this to false to switch the whole
# feature off for everyone the server serves.
# MEMORY=true

# Connectors: the coding agents Star may hand a task to. Off unless you name
# one, because a connector runs a CLI that edits files on this machine. Both
# are dispatched by the Node process, never by the page, and each has to be
# installed and logged in already.
# CONNECTORS=claude,codex

# Where they work, how long one gets, and how many may run at once.
# CONNECTOR_CWD=/path/to/the/repo         # default: where the server was started
# CONNECTOR_TIMEOUT=900                   # seconds
# CONNECTOR_LIMIT=3
# CONNECTOR_ANNOUNCE=true                 # Star says so when a task settles

# Claude Code — run as `claude -p <task> --output-format json`.
# CLAUDE_COMMAND=claude                   # a whole command line: `npx claude`, `docker exec ... claude`
# CLAUDE_MODEL=
# CLAUDE_PERMISSION_MODE=acceptEdits      # plan | acceptEdits | bypassPermissions
# CLAUDE_ARGS=--add-dir /some/other/tree
# CLAUDE_CWD=                             # overrides CONNECTOR_CWD for this agent

# Codex — run as `codex exec --json --sandbox <mode> <task>`.
# CODEX_COMMAND=codex
# CODEX_MODEL=
# CODEX_SANDBOX=workspace-write           # read-only | workspace-write | danger-full-access
# CODEX_ARGS=--skip-git-repo-check
# CODEX_CWD=

# Remote MCP servers, as a JSON array. Anything with credentials belongs here
# rather than in the page — the proxy is the only thing that reads it.
# Alternatively drop the same array in ./mcp.json, which is gitignored.
# XAI_MCP_SERVERS=[{"server_label":"my-tools","server_url":"https://mcp.example.com/mcp","authorization":"Bearer ..."}]

# PORT=5173
